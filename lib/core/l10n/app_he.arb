  "cueSliceInner": "סובבו רק את השכבה הפנימית שליד הפאה של המרכז ה{face}. הפאה עצמה לא זזה, ולכן המרכזים נפרדים.",
  "cueSliceWide": "סיבוב רחב: הפאה של המרכז ה{face} והשכבה הפנימית שלידה מסתובבות יחד, כמו שכבה עבה אחת.",
  "cueTurnCube": "סובבו את כל הקובייה כך שהמרכז ה{top} יהיה למעלה והמרכז ה{front} מולכם.",
  "cueTurnTop": "סובבו רק את השכבה העליונה, לפי החץ, כדי להכין את האלגוריתם הבא.",
  "cueAlignTop": "מהלך אחרון: סובבו את השכבה העליונה כדי ליישר את הצבעים. סיימתם!",
  "cueCrossTop": "הקצה בצבעי {piece} נמצא בשכבה העליונה. סובבו את השורה העליונה עד שהוא בדיוק מעל המרכז ה{center}, ואז סובבו את הפאה הזו פעמיים כדי להוריד אותו.",
  "cueCrossMiddle": "הקצה בצבעי {piece} תקוע בשכבה האמצעית. העלו אותו למעלה, יישרו אותו מעל המרכז ה{center}, ואז הורידו אותו.",
  "cueCrossFlipped": "הקצה בצבעי {piece} במקום שלו אבל הפוך: הלבן שלו פונה הצידה. הוציאו אותו והעלו אותו למעלה, הלבן כלפי מעלה, ואז הורידו אותו ליד המרכז ה{center}.",
  "cueCrossBottom": "בסגנון \u2066CFOP\u2069 מותר לסובב גם את התחתית. הכניסו את הקצה בצבעי {piece} וסובבו את התחתית כך שיתיישר עם המרכז ה{center}.",
  "cueCornerTop": "סובבו את הפאה העליונה עד שהפינה בצבעי {piece} נמצאת בדיוק מעל המקום שלה, בין הצד ה{a} לצד ה{b}. חזרו על תנועת יד ימין עד שהיא נכנסת, מסובבת נכון.",
  "cueCornerTwisted": "הפינה בצבעי {piece} במקום שלה אבל מסובבת. טריגר אחד מקפיץ אותה החוצה (פינה צהובה נכנסת במקומה); המשיכו לחזור מעל אותו מקום עד שהיא נכנסת שוב עם הלבן למטה. אל תסובבו את הקובייה כדי לרדוף אחריה.",
  "cueMiddleRight": "סובבו את השורה העליונה עד שהקצה בצבעי {piece} מיושר עם המרכז ה{a}, ואז שלחו אותו למטה ימינה, אל המקום שבין ה{a} ל{b}.",
  "cueMiddleLeft": "סובבו את השורה העליונה עד שהקצה בצבעי {piece} מיושר עם המרכז ה{a}, ואז שלחו אותו למטה שמאלה, אל המקום שבין ה{a} ל{b}.",
  "cueMiddleFlipped": "הקצה בצבעי {piece} במקום שלו אבל הפוך. הכניסו לשם קצה צהוב כדי לדחוף אותו למעלה, ואז הכניסו אותו שוב בין ה{a} ל{b}.",
  "cueYellowLine": "קו צהוב: סובבו את השורה העליונה כך שהקו יעבור משמאל לימין, השאירו את ה{front} מולכם ובצעו את אלגוריתם הצלב הצהוב.",
  "cueYellowL": "צורת ⁦L⁩ צהובה: סובבו את הפאה העליונה כך שה־⁦L⁩ תצביע אחורה־שמאלה, השאירו את ה{front} מולכם ובצעו את האלגוריתם. היא תהפוך לקו.",
  "cueYellowDot": "רק המרכז הצהוב צהוב: נקודה. בצעו את האלגוריתם פעם אחת כשה{front} מולכם כדי לקבל L. נקודה יכולה לקחת שלושה סבבים, אז המשיכו.",
  "cueEdgesMatch": "סובבו את השורה העליונה עד שהקצה בצבעי {piece} תואם את המרכז ה{center}.",
  "cueEdgesSwap": "שני קצוות תואמים נמצאים מאחור ומימין. כשה{front} מולכם, בצעו את ההחלפה: הקצה הקדמי והשמאלי מתחלפים.",
  "cueEdgesOpposite": "הקצוות התואמים נמצאים זה מול זה. בצעו את ההחלפה פעם אחת כשה{front} מולכם; אחר כך שני קצוות שכנים יתאימו.",
  "cueCornersCycle": "הפינה בצבעי {piece} כבר במקום שלה. השאירו אותה בקדמי־ימני, כשה{front} מולכם, והעבירו במחזור את שלוש הפינות האחרות.",
  "cueCornersNone": "אף פינה צהובה עוד לא במקומה. בצעו מחזור אחד כשה{front} מולכם; אחריו פינה אחת תהיה בבית.",
  "cueTwistCorner": "סובבו את הפינה בצבעי {piece} שקדימה מימין: חזרו על הטריגר התחתון בזוגות עד שהצהוב שלה פונה למעלה. השכבות התחתונות נראות מבולגנות בינתיים; הן חוזרות עם הפינה האחרונה!",
  "cueTwistFour": "הפינה בצבעי {piece} צריכה הפעם ארבע חזרות. המשיכו: הצהוב תמיד עולה אחרי שתיים או ארבע.",
  "cueTwistNext": "סובבו רק את השכבה העליונה כדי להביא את הפינה המסובבת הבאה לקדמי־ימני. לא לסובב עכשיו את כל הקובייה!",
  "cueF2lPair": "חברו את הפינה בצבעי {piece} עם הקצה בצבעי {edge} למעלה, ואז הכניסו את הזוג למקום שבין ה{a} ל{b}.",
  "cueF2lStuck": "הפינה בצבעי {piece} תקועה במקום שלה עם הקצה הלא נכון. קודם הוציאו אותה למעלה, ואז חברו אותה לזוג והכניסו.",
  "cueOllSune": "כשה{front} מולכם, בצעו ⁦Sune⁩ כדי להפוך את הפינות הצהובות כלפי מעלה.",
  "cueOllSuneAgain": "הפעם ⁦Sune⁩ אחד לא הספיק. סובבו את הפאה העליונה ובצעו ⁦Sune⁩ שוב, כשה{front} מולכם.",
  "cuePllCorners": "שתי פינות צריכות להתחלף. השאירו את הזוג התואם (״פנסים״) משמאל, כשה{front} מולכם, ובצעו ⁦T-perm⁩.",
  "cuePllEdges": "הפינות מוכנות. השאירו את הקצה בצבעי {piece} מאחור והעבירו במחזור את שלושת הקצוות האחרים עם \u2066U-perm\u2069.",
  "cuePllNoEdge": "אף קצה עליון עוד לא תואם את המרכז שלו. בצעו \u2066U-perm\u2069 פעם אחת מכל צד שתבחרו; אחריו קצה אחד יתאים.",
  "cueTwoSwapAdjacent": "שתי פינות עליונות שכנות צריכות להתחלף. השאירו את הזוג התואם משמאל, כשה{front} מולכם, ובצעו את ההחלפה.",
  "cueTwoSwapDiagonal": "שתי הפינות שצריך להחליף נמצאות באלכסון. בצעו את ההחלפה האלכסונית כשה{front} מולכם.",
  "cueCenterCycle": "החזירו הביתה את חלק המרכז ה{color} שנדד, בעזרת מחזור מרכזים: שכבה פנימית, למעלה, שכבה פנימית, ואז הכול חזרה.",
  "cueCenterBar": "פס שלם של חלקי מרכז בצבע {color} נמצא על הפאה הלא נכונה. הרימו אותו עם השכבה הפנימית, סובבו את הפאה העליונה והחזירו אותו הביתה.",
