  "stepPllUBody": "Setelah sudut selesai, U-perm memutar tiga rusuk. Letakkan sisi yang sudah selesai di belakang.",
  "lessonTwoFirst": "Lapisan pertama 2×2",
  "lessonTwoFirstDesc": "Bentuk satu sisi dengan sudut yang cocok.",
  "stepTwoIntro": "Hanya sudut",
  "stepTwoIntroBody": "2×2 adalah 3×3 tanpa rusuk dan pusat. Pilih satu warna, bentuk sisi itu di bawah, dan cocokkan warna samping sudut-sudut yang bersebelahan.",
  "stepTwoCorner": "Masukkan sudut",
  "stepTwoCornerBody": "Persis seperti sudut putih pada 3×3: bawa sudut ke atas tempatnya dan gunakan R U R' U' sampai pas.",
  "lessonTwoOll": "Orientasikan bagian atas",
  "lessonTwoOllDesc": "OLL Ortega dengan Sune.",
  "stepTwoSune": "Sune lagi",
  "stepTwoSuneBody": "Sune juga membuat bagian atas 2×2 menjadi kuning. Pengguna Ortega mempelajari tujuh kasus pendek; Sune dan cerminnya mencakup sebagian besar.",
  "lessonTwoPbl": "Permutasi kedua lapisan",
  "lessonTwoPblDesc": "Tukar sudut untuk menyelesaikan.",
  "stepTwoAdjacent": "Tukar berdampingan",
  "stepTwoAdjacentBody": "Jika dua sudut atas yang bersebelahan harus ditukar, pegang keduanya di kanan dan gunakan T-perm.",
  "stepTwoDiagonal": "Tukar diagonal",
  "stepTwoDiagonalBody": "Dua sudut di posisi berseberangan ditukar dengan Y-perm.",
  "lessonBigIntro": "Kepingan kubus besar",
  "lessonBigIntroDesc": "Pusat, sayap, dan irisan.",
  "stepBigPieces": "Pusat tidak tetap",
  "stepBigPiecesBody": "Pada 4×4, setiap sisi punya empat kepingan pusat yang bisa berpindah, dan setiap rusuk terdiri dari dua sayap. Reduksi mengelompokkannya agar kubus berperilaku seperti 3×3.",
  "stepBigSlices": "Putaran lebar dan dalam",
  "stepBigSlicesBody": "Rw memutar dua lapisan kanan bersama-sama. 2R hanya memutar lapisan kedua dari kanan. Putaran ini memindahkan pusat dan sayap.",
  "lessonBigCenters": "Pusat",
  "lessonBigCentersDesc": "Kelompokkan kepingan pusat.",
  "stepBigCenterCycle": "Siklus-3 pusat",
  "stepBigCenterCycleBody": "Komutator ini memindahkan tepat tiga kepingan pusat dan tidak menyentuh yang lain, jadi pusat yang sudah jadi tetap jadi.",
  "lessonBigEdges": "Pasangkan rusuk",
  "lessonBigEdgesDesc": "Gabungkan sayap menjadi rusuk utuh.",
  "stepBigEdgePair": "Pasangkan & pulihkan",
  "stepBigEdgePairBody": "Uw' menyejajarkan dua sayap yang cocok, R U R' F R' F' R menukar masuk rusuk yang belum berpasangan, dan Uw mengembalikan pusat.",
  "lessonBigParity": "Paritas",
  "lessonBigParityDesc": "Paritas OLL dan PLL pada kubus genap.",
  "stepBigOllParity": "Paritas OLL",
  "stepBigOllParityBody": "Satu rusuk terbalik tidak mungkin terjadi pada 3×3. Pada kubus genap, algoritma ini membalik kembali rusuk depan atas. Algoritma ini bisa mengacak sisa lapisan atas, yang toh akan diperbaiki oleh langkah terakhir 3×3.",
  "stepBigPllParity": "Paritas PLL",
  "stepBigPllParityBody": "Dua rusuk tertukar di bagian paling akhir? 2R2 U2 2R2 Uw2 2R2 Uw2 menukar rusuk atas depan dan belakang."
}
