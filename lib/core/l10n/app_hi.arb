  "cueFaceTurn": "{face} केंद्र वाली फ़ेस को तीर की दिशा में घुमाएँ। केंद्र अपनी जगह रहता है; सिर्फ़ उसके आसपास के टुकड़े चलते हैं।",
  "cueTrigger": "दाएँ हाथ का ट्रिगर, {front} आपकी ओर: दायाँ फ़ेस ऊपर, ऊपरी परत बाएँ, दायाँ फ़ेस नीचे, ऊपरी परत वापस दाएँ।",
  "cueTriggerBack": "लगातार छठा ट्रिगर क्यूब को ठीक पहले जैसा कर देता है। छह जादुई संख्या है!",
  "cueSliceInner": "{face} फ़ेस के बगल वाली सिर्फ़ अंदरूनी परत घुमाएँ। फ़ेस खुद नहीं हिलता, इसलिए केंद्र अलग हो जाते हैं।",
  "cueSliceWide": "चौड़ी चाल: {face} फ़ेस और उसके बगल की अंदरूनी परत एक मोटी परत की तरह साथ घूमती हैं।",
  "cueTurnCube": "पूरे क्यूब को ऐसे घुमाएँ कि {top} केंद्र ऊपर हो और {front} केंद्र आपकी ओर हो।",
  "cueTurnTop": "अगले एल्गोरिद्म की तैयारी के लिए तीर के अनुसार सिर्फ़ ऊपरी परत घुमाएँ।",
  "cueAlignTop": "आख़िरी चाल: ऊपरी परत घुमाकर रंग मिला दें। हो गया!",
  "cueCrossTop": "{piece} एज ऊपरी परत में है। ऊपरी परत घुमाएँ जब तक वह {center} केंद्र के ठीक ऊपर न आ जाए, फिर उसे नीचे लाने के लिए वह फ़ेस दो बार घुमाएँ।",
  "cueCrossMiddle": "{piece} एज बीच की परत में फँसा है। उसे ऊपर लाएँ, {center} केंद्र के ऊपर मिलाएँ, फिर नीचे लाएँ।",
  "cueCrossFlipped": "{piece} एज अपनी जगह पर है पर पलटा हुआ है: उसका सफ़ेद साइड की ओर है। उसे निकालें और सफ़ेद ऊपर करके ऊपर ले जाएँ, फिर {center} केंद्र के बगल में उतारें।",
  "cueCrossBottom": "CFOP तरीके में नीचे की परत भी घुमा सकते हैं। {piece} एज नीचे लाएँ और नीचे की परत घुमाकर उसे {center} केंद्र से मिलाएँ।",
  "cueCornerTop": "ऊपरी परत घुमाएँ जब तक {piece} कोना अपनी जगह के ठीक ऊपर, {a} और {b} साइड के बीच, न आ जाए। दाएँ हाथ का ट्रिगर दोहराएँ जब तक वह सही घूमकर अंदर न बैठ जाए।",
  "cueCornerTwisted": "{piece} कोना अपनी जगह पर है पर मुड़ा हुआ है। एक ट्रिगर उसे बाहर निकालता है (उसकी जगह पीला कोना आता है); उसी जगह के ऊपर दोहराते रहें जब तक वह सफ़ेद नीचे करके वापस न बैठे। उसके पीछे क्यूब न घुमाएँ।",
  "cueMiddleRight": "ऊपरी परत घुमाएँ जब तक {piece} एज {a} केंद्र से न मिल जाए, फिर उसे नीचे दाईं ओर, {a} और {b} के बीच की जगह में भेजें।",
  "cueMiddleLeft": "ऊपरी परत घुमाएँ जब तक {piece} एज {a} केंद्र से न मिल जाए, फिर उसे नीचे बाईं ओर, {a} और {b} के बीच की जगह में भेजें।",
  "cueMiddleFlipped": "{piece} एज अपनी जगह पर है पर पलटा हुआ है। वहाँ एक पीला एज डालकर उसे ऊपर धकेलें, फिर उसे {a} और {b} के बीच दोबारा डालें।",
  "cueYellowLine": "पीली रेखा: ऊपरी परत घुमाएँ ताकि रेखा बाएँ से दाएँ जाए, {front} को अपनी ओर रखें, फिर पीले क्रॉस का एल्गोरिद्म करें।",
  "cueYellowL": "पीला L: ऊपरी परत घुमाएँ ताकि L पीछे-बाईं ओर इशारा करे, {front} को अपनी ओर रखें, फिर एल्गोरिद्म करें। यह रेखा बन जाता है।",
  "cueYellowDot": "सिर्फ़ केंद्र पीला है: बिंदु। {front} को अपनी ओर रखकर एल्गोरिदम एक बार करें, L बनेगा। बिंदु में तीन राउंड लग सकते हैं, करते रहें।",
  "cueEdgesMatch": "ऊपरी परत घुमाएँ जब तक {piece} एज {center} केंद्र से न मिल जाए।",
  "cueEdgesSwap": "मिले हुए दो एज पीछे और दाईं ओर हैं। {front} को अपनी ओर रखकर अदला-बदली करें: सामने और बाएँ वाले एज जगह बदलते हैं।",
  "cueEdgesOpposite": "मिले हुए एज आमने-सामने हैं। {front} को अपनी ओर रखकर अदला-बदली एक बार करें; उसके बाद दो पड़ोसी एज मिल जाएँगे।",
  "cueCornersCycle": "{piece} कोना पहले से अपनी जगह पर है। उसे आगे-दाईं ओर रखें, {front} आपकी ओर, और बाकी तीन कोनों को घुमाकर बदलें।",
  "cueCornersNone": "अभी कोई पीला कोना अपनी जगह पर नहीं है। {front} को अपनी ओर रखकर एक बार चक्र करें; उसके बाद एक कोना अपनी जगह पर होगा।",
  "cueTwistCorner": "आगे-दाएँ {piece} कोना घुमाएँ: नीचे वाला ट्रिगर जोड़ों में दोहराएँ जब तक उसका पीला ऊपर न आए। निचली परतें अभी बिखरी दिखेंगी; आख़िरी कोने के साथ लौट आएँगी!",
  "cueTwistFour": "इस बार {piece} कोने को चार ट्रिगर चाहिए। जारी रखें: पीला रंग हमेशा दो या चार के बाद ऊपर आता है।",
  "cueTwistNext": "अगले मुड़े हुए कोने को आगे-दाईं ओर लाने के लिए सिर्फ़ ऊपरी परत घुमाएँ। अभी पूरा क्यूब न घुमाएँ!",
  "cueF2lPair": "ऊपर {piece} कोने को {edge} एज के साथ जोड़ें, फिर जोड़ी को {a} और {b} के बीच की जगह में डालें।",
  "cueF2lStuck": "{piece} कोना गलत एज के साथ अपनी जगह में फँसा है। पहले उसे ऊपर निकालें, फिर जोड़ी बनाकर डालें।",
  "cueOllSune": "{front} को अपनी ओर रखकर Sune करें, ताकि पीले कोने ऊपर की ओर हो जाएँ।",
  "cueOllSuneAgain": "इस बार एक Sune काफ़ी नहीं था। ऊपरी परत घुमाएँ और {front} को अपनी ओर रखकर फिर से Sune करें।",
  "cuePllCorners": "दो कोनों को अदला-बदली करनी है। मिलती हुई जोड़ी (हेडलाइट्स) को बाईं ओर रखें, {front} आपकी ओर, और T-perm करें।",
  "cuePllEdges": "कोने तैयार हैं। {piece} एज को पीछे रखें और बाकी तीन एज को U-perm से घुमाकर बदलें।",
  "cuePllNoEdge": "अभी कोई ऊपरी एज अपने केंद्र से नहीं मिलता। किसी भी ओर से एक बार U-perm करें; उसके बाद एक एज मिल जाएगा।",
  "cueTwoSwapAdjacent": "ऊपर के दो पड़ोसी कोनों को अदला-बदली करनी है। मिलती जोड़ी को बाईं ओर रखें, {front} आपकी ओर, और अदला-बदली करें।",
  "cueTwoSwapDiagonal": "बदलने वाले दो कोने तिरछे आमने-सामने हैं। {front} को अपनी ओर रखकर तिरछी अदला-बदली करें।",
  "cueCenterCycle": "भटके हुए {color} केंद्र टुकड़े को केंद्रों के 3-साइकिल से घर लाएँ: परत, ऊपर, परत, फिर सब वापस।",
  "cueCenterBar": "{color} केंद्र टुकड़ों की पूरी पट्टी गलत फ़ेस पर है। उसे अंदरूनी परत से उठाएँ, ऊपरी परत घुमाएँ और घर वापस लाएँ।",
  "cueEdgePair": "{piece} एज के दोनों टुकड़े जोड़ें: उन्हें सीध में लाएँ, परत घुमाएँ, दाएँ हाथ की चालों से एक बिना जोड़ी वाला एज बदलें और परत वापस घुमाएँ।",
  "cueEdgeLast": "आख़िरी एज: {piece} एज को आख़िरी दो एज वाले एल्गोरिद्म से जोड़ें, जो तैयार सभी एज को बरकरार रखता है।",
  "cueParityOll": "OLL पैरिटी: ऊपर का एक एज पलटा है, जो 3×3 में कभी नहीं होता। उसे सामने रखें, {front} आपकी ओर, और किसी भी सामान्य OLL से पहले पैरिटी सुधार करें।",
  "cueParityPll": "PLL पैरिटी: ऊपर के दो एज बदले हुए हैं, जो 3×3 में कभी नहीं होता। उन्हें आगे और पीछे रखें, पैरिटी स्वैप करें, फिर ऊपर सीधा करें।",
  "cueParityFive": "एज पैरिटी: एक एज के दोनों बाहरी विंग बदले हुए हैं, 5×5 की इकलौती पैरिटी। उस एज को सामने रखें, {front} आपकी ओर, और सुधार एक बार करें।",
  "cueParityInnerWing": "अंदरूनी-विंग पैरिटी: ऊपरी एज के सिर्फ़ 2 अंदरूनी विंग पलटे हैं। उसे सामने रखें, {front} आपकी ओर, और सिर्फ़ तीसरी स्लाइस घुमाएँ।",
  "wingRuleAllFour": "चारों विंग पलटे",
  "wingRuleAllFourFix": "3-परत OLL पैरिटी (3Rw)",
  "wingRuleInnerTwo": "सिर्फ़ 2 अंदरूनी विंग पलटे",
  "wingRuleInnerTwoFix": "अंदरूनी-विंग पैरिटी (3R)",
