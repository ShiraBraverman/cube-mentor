  "stepBasicsPiecesBody": "Tâm không bao giờ di chuyển và quyết định màu của mỗi mặt. Cạnh có hai màu, góc có ba màu. Giải khối nghĩa là đưa mọi cạnh và góc về cạnh các tâm cùng màu.",
  "stepBasicsFaces": "Sáu chữ cái của các mặt",
  "stepBasicsFacesBody": "R, L, U, D, F và B là mặt phải, trái, trên, dưới, trước và sau. Một chữ cái đứng riêng nghĩa là xoay một phần tư vòng theo chiều kim đồng hồ, như khi bạn nhìn thẳng vào mặt đó.",
  "stepBasicsPrime": "Nước ngược và nước kép",
  "stepBasicsPrimeBody": "Dấu phẩy trên (R') nghĩa là xoay ngược lại, ngược chiều kim đồng hồ. Số 2 (U2) là nửa vòng: hai lần một phần tư vòng.",
  "stepCrossGoal": "Mục tiêu",
  "stepCrossGoalBody": "Cầm mặt vàng ở trên. Bốn cạnh trắng nằm quanh tâm trắng ở dưới, màu mặt bên của mỗi cạnh khớp với tâm bên cạnh.",
  "stepCrossTop": "Cạnh ở tầng trên",
  "stepCrossTopBody": "Tìm một cạnh trắng ở tầng trên. Xoay tầng trên cho đến khi màu mặt bên của nó nằm trên tâm cùng màu, rồi xoay mặt đó hai lần để đưa cạnh xuống.",
  "stepCrossMiddle": "Cạnh ở tầng giữa",
  "stepCrossMiddleBody": "Cạnh kẹt ở tầng giữa phải đưa lên trước: xoay mặt bên của nó lên, dời tầng trên đi chỗ khác rồi xoay mặt bên trở lại, để dấu cộng không bị phá. Sau đó đặt nó từ tầng trên.",
  "stepCornersInsert": "Ngay trên vị trí",
  "stepCornersInsertBody": "Xoay tầng trên cho đến khi một góc trắng nằm ngay trên vị trí của nó, ở phía trước bên phải. R U R' U' sẽ đưa nó xuống.",
  "stepCornersRepeat": "Lặp lại công thức",
  "stepCornersRepeatBody": "Nếu màu trắng quay sai hướng, cứ lặp lại R U R' U' ở cùng vị trí đó. Mỗi góc sẽ xong sau tối đa năm lần lặp.",
  "stepMiddleRight": "Cạnh sang phải",
  "stepMiddleRightBody": "Căn một cạnh ở tầng trên với tâm của nó ở mặt trước. Nếu màu trên của nó khớp với tâm bên phải, đưa vào bằng U R U' R' U' F' U F.",
  "stepMiddleLeft": "Cạnh sang trái",
  "stepMiddleLeftBody": "Nếu màu trên khớp với tâm bên trái, dùng công thức đối xứng: U' L' U L U F U' F'.",
  "stepYellowCross": "Một công thức",
  "stepYellowCrossBody": "F R U R' U' F' biến chấm vàng thành hình chữ L, chữ L thành đường thẳng và đường thẳng thành dấu cộng. Giữ chữ L ở phía sau bên trái và đường thẳng nằm ngang.",
  "stepYellowEdges": "Khớp các cạnh",
  "stepYellowEdgesBody": "Xoay tầng trên cho đến khi hai cạnh khớp với tâm. Với một cạnh ở phía sau và một cạnh bên phải, R U R' U R U2 R' U sẽ đổi chỗ hai cạnh còn lại.",
  "stepPlaceCorners": "Đặt đúng chỗ",
  "stepPlaceCornersBody": "Giữ một góc đã đúng vị trí ở phía trước bên phải. U R U' L' U R' U' L di chuyển ba góc còn lại; lặp lại cho đến khi cả bốn về đúng chỗ.",
  "stepTwistCorners": "Xoắn góc",
  "stepTwistCornersBody": "Với một góc chưa giải ở phía trước bên phải, lặp lại R' D' R D cho đến khi màu vàng ở trên, rồi chỉ xoay tầng trên để đưa góc tiếp theo vào. Tầng dưới trông như bị phá cho đến tận cuối: cứ tiếp tục.",
  "lessonCfopIntro": "CFOP là gì?",
  "lessonCfopIntroDesc": "Cross, F2L, OLL, PLL.",
  "stepCfopOverview": "Bốn giai đoạn",
  "stepCfopOverviewBody": "Người chơi speedcube giải dấu cộng, rồi ghép mỗi góc tầng một với cạnh tầng giữa của nó (F2L), định hướng tầng cuối (OLL) và cuối cùng hoán vị nó (PLL).",
  "stepCfopCross": "Lên kế hoạch dấu cộng",
  "stepCfopCrossBody": "Trong CFOP, dấu cộng được lên kế hoạch trong lúc quan sát và dựng ở mặt dưới trong khoảng tám nước.",
  "lessonF2l": "F2L cơ bản",
  "lessonF2lDesc": "Ghép một góc với cạnh của nó.",
  "stepF2lRight": "Đưa một cặp vào",
  "stepF2lRightBody": "Khi một góc và cạnh của nó nằm cạnh nhau ở tầng trên, đưa chúng lên trên ô của chúng và đưa vào cùng lúc.",
  "stepF2lLeft": "Cặp bên trái",
  "stepF2lLeftBody": "Trường hợp tương tự ở phía bên kia là công thức đối xứng, U' L' U L. Xoay cả khối (y) giúp bạn dùng tay nào thuận hơn.",
  "lessonOll": "OLL hai bước",
  "lessonOllDesc": "Làm mặt trên thành màu vàng.",
  "stepOllCross": "Cạnh trước",
  "stepOllCrossBody": "OLL hai bước bắt đầu bằng công thức dấu cộng vàng mà bạn đã biết.",
  "stepOllSune": "Sune",
  "stepOllSuneBody": "Với một góc vàng hướng lên ở phía trước bên trái, Sune (R U R' U R U2 R') định hướng ba góc còn lại. Hầu hết các trường hợp khác dùng Sune và bản đối xứng của nó.",
  "lessonPll": "PLL hai bước",
  "lessonPllDesc": "Hoàn thành khối.",
  "stepPllT": "T-perm",
  "stepPllTBody": "T-perm đổi chỗ hai góc và hai cạnh. Dùng nó để đặt các góc: giữ hai góc cần đổi chỗ ở bên phải.",
  "stepPllU": "U-perm",
  "stepPllUBody": "Khi các góc đã xong, U-perm hoán vị vòng ba cạnh. Giữ mặt đã hoàn chỉnh ở phía sau.",
  "lessonTwoFirst": "Tầng một của 2×2",
  "lessonTwoFirstDesc": "Dựng một mặt với các góc khớp nhau.",
  "stepTwoIntro": "Chỉ có góc",
  "stepTwoIntroBody": "Khối 2×2 là khối 3×3 không có cạnh và tâm. Chọn một màu, dựng mặt đó ở dưới, và làm cho màu mặt bên của các góc kề nhau khớp với nhau.",
  "stepTwoCorner": "Đưa góc vào",
  "stepTwoCornerBody": "Giống hệt các góc trắng của 3×3: đưa góc lên trên vị trí của nó và dùng R U R' U' cho đến khi vừa khít.",
  "lessonTwoOll": "Định hướng mặt trên",
  "lessonTwoOllDesc": "OLL Ortega với Sune.",
  "stepTwoSune": "Lại là Sune",
  "stepTwoSuneBody": "Sune cũng làm mặt trên của 2×2 thành màu vàng. Người giải theo Ortega học bảy trường hợp ngắn; Sune và bản đối xứng của nó bao gồm phần lớn.",
  "lessonTwoPbl": "Hoán vị cả hai tầng",
  "lessonTwoPblDesc": "Đổi chỗ các góc để hoàn thành.",
  "stepTwoAdjacent": "Đổi chỗ kề nhau",
  "stepTwoAdjacentBody": "Khi hai góc kề nhau ở tầng trên cần đổi chỗ, giữ chúng ở bên phải và dùng T-perm.",
  "stepTwoDiagonal": "Đổi chỗ chéo",
  "stepTwoDiagonalBody": "Hai góc ở vị trí đối diện nhau được đổi chỗ bằng Y-perm.",
  "lessonBigIntro": "Các viên của khối lớn",
  "lessonBigIntroDesc": "Tâm, cánh và tầng giữa.",
  "stepBigPieces": "Không có tâm cố định",
  "stepBigPiecesBody": "Trên khối 4×4, mỗi mặt có bốn viên tâm di chuyển được, và mỗi cạnh gồm hai cánh. Phương pháp rút gọn gom chúng lại để khối hoạt động như 3×3.",
  "stepBigSlices": "Xoay kép và xoay tầng trong",
  "stepBigSlicesBody": "Rw xoay cùng lúc hai tầng bên phải. 2R chỉ xoay tầng thứ hai tính từ bên phải. Các nước này di chuyển tâm và cánh.",
  "lessonBigCenters": "Tâm",
  "lessonBigCentersDesc": "Gom các viên tâm.",
  "stepBigCenterCycle": "Hoán vị vòng 3 viên tâm",
  "stepBigCenterCycleBody": "Commutator này di chuyển đúng ba viên tâm và không động đến phần còn lại, nên các tâm đã xong vẫn giữ nguyên.",
  "lessonBigEdges": "Ghép cạnh",
  "lessonBigEdgesDesc": "Ghép các cánh thành cạnh hoàn chỉnh.",
  "stepBigEdgePair": "Ghép và khôi phục",
  "stepBigEdgePairBody": "Uw' xếp hai cánh cùng màu thẳng hàng, R U R' F R' F' R đưa một cạnh chưa ghép vào, và Uw đưa các tâm trở lại.",
  "lessonBigParity": "Parity",
  "lessonBigParityDesc": "Parity OLL và PLL trên khối chẵn.",
  "stepBigOllParity": "Parity OLL",
  "stepBigOllParityBody": "Một cạnh bị lật đơn lẻ không thể xảy ra trên 3×3. Trên khối chẵn, công thức này lật cạnh trên-trước trở lại. Nó có thể xáo phần còn lại của tầng trên, nhưng các bước 3×3 cuối cùng vẫn sẽ sửa lại.",
  "stepBigPllParity": "Parity PLL",
  "stepBigPllParityBody": "Hai cạnh bị đổi chỗ ở bước cuối cùng? 2R2 U2 2R2 Uw2 2R2 Uw2 đổi chỗ cạnh trên phía trước và phía sau.",
  "introGoalHeading": "Mục tiêu là gì?",
  "introHowHeading": "Làm thế nào?",
  "introStart": "Hiểu rồi, bắt đầu từng bước",
  "introDontShowAgain": "Không tự động hiển thị nữa",
  "introShowGoal": "Xem mục tiêu",
  "introStateStart": "Bắt đầu",
  "introStateGoal": "Mục tiêu",
  "introPlayMorph": "Phát từ đầu đến mục tiêu",
  "introGoalBasics": "Học cách đọc khối: các viên, sáu mặt và cách các chữ cái ký hiệu xoay chúng.",
  "introGoalCross": "Tạo dấu cộng trắng sao cho mỗi cạnh trắng cũng khớp màu với tâm bên cạnh.",
  "introGoalCorners": "Lấp bốn góc trắng để hoàn thành vương miện thứ nhất, toàn bộ tầng trắng.",
  "introGoalMiddle": "Đặt bốn cạnh tầng giữa để hoàn thành hai tầng đầu.",
  "introGoalYellowCross": "Tạo dấu cộng vàng ở trên; màu mặt bên chưa cần khớp.",
  "introGoalYellowEdges": "Căn mỗi cạnh của dấu cộng vàng với màu tâm ở mặt bên của nó.",
  "introGoalYellowCorners": "Đưa mỗi góc vàng về đúng chỗ, kể cả khi nó vẫn còn bị xoắn.",
  "introGoalTwistCorners": "Xoắn các góc vàng đúng hướng để cả khối được giải.",
  "introGoalCfopIntro": "Xem kế hoạch của speedcube: dấu cộng, hai tầng đầu, rồi tầng cuối trong hai bước.",
  "introGoalF2l": "Đưa mỗi góc trắng vào cùng với cạnh tầng giữa của nó, hoàn thành hai tầng cùng lúc.",
  "introGoalOll": "Làm cả mặt trên thành màu vàng bằng một hoặc hai công thức.",
  "introGoalPll": "Đưa các viên tầng cuối về đúng chỗ để hoàn thành khối.",
  "introGoalTwoFirst": "Dựng một tầng trắng hoàn chỉnh trên khối 2×2.",
  "introGoalTwoOll": "Làm mặt trên của 2×2 thành toàn màu vàng.",
  "introGoalTwoPbl": "Đổi chỗ các góc cuối về đúng vị trí để giải khối 2×2.",
  "introGoalBigIntro": "Làm quen với 4×4: tâm, cặp cạnh và góc, cùng các nước xoay chúng.",
  "introGoalBigCenters": "Gom các viên tâm của mỗi mặt thành một khối màu liền.",
  "introGoalBigEdges": "Ghép các mảnh cạnh cùng màu để mỗi cạnh trông như một cạnh 3×3.",
  "introGoalBigParity": "Sửa hai trường hợp của 4×4 mà 3×3 không bao giờ có: một cạnh bị lật hoặc hai cạnh bị đổi chỗ.",
  "introHowBasics": "Tâm không bao giờ di chuyển, nên chúng cho biết màu của mỗi mặt.\nMỗi chữ cái xoay một mặt một phần tư vòng theo chiều kim đồng hồ.\nDấu phẩy trên (') xoay ngược lại; số 2 xoay hai lần.",
  "introHowCross": "Cầm mặt vàng ở trên: dấu cộng trắng được dựng ở mặt dưới.\nTìm một cạnh trắng và căn màu mặt bên của nó với tâm cùng màu.\nXoay mặt đó hai lần để đưa cạnh vào chỗ.",
  "introHowCorners": "Đưa một góc trắng lên trên ô trống của nó.\nLặp lại R U R' U' cho đến khi nó vào đúng hướng.\nLàm tương tự với ba góc còn lại.",
  "introHowMiddle": "Tìm một cạnh ở tầng trên không có màu vàng và khớp màu trước của nó với một tâm.\nĐưa nó sang phải hoặc trái bằng một công thức ngắn 8 nước.\nTầng trắng luôn trở lại nguyên vẹn.",
  "introHowYellowCross": "Nhìn mặt trên: một chấm, chữ L hoặc đường thẳng.\nGiữ như hình và làm F R U R' U' F'.\nLặp lại cho đến khi dấu cộng vàng xuất hiện.",
  "introHowYellowEdges": "Xoay tầng trên cho đến khi hai cạnh khớp với tâm.\nGiữ chúng ở phía sau và bên phải, rồi làm R U R' U R U2 R' U.\nLặp lại cho đến khi cả bốn cạnh khớp.",
  "introHowYellowCorners": "Một góc đúng chỗ khi màu của nó khớp với ba mặt xung quanh.\nGiữ một góc đã đúng chỗ ở phía trước bên phải.\nU R U' L' U R' U' L hoán vị ba góc còn lại cho đến khi tất cả vừa khít.",
  "introHowTwistCorners": "Giữ một góc chưa giải ở phía trước bên phải.\nLặp lại R' D' R D cho đến khi màu vàng của nó hướng lên.\nChỉ xoay tầng trên để chuyển sang góc tiếp theo; tầng dưới tự trở lại ở cuối.",
  "introHowCfopIntro": "Cross: bốn cạnh, lên kế hoạch trong lúc quan sát.\nF2L: mỗi góc được đưa vào cùng với cạnh của nó.\nOLL làm mặt trên thành màu vàng, rồi PLL đưa các viên về chỗ.",
  "introHowF2l": "Tìm một góc và cạnh cùng màu với nó ở tầng trên.\nGhép chúng thành cặp ngay trên ô của chúng.\nĐưa cặp vào bằng ba hoặc bốn nước.",
  "introHowOll": "Trước hết là dấu cộng vàng với F R U R' U' F'.\nSau đó định hướng các góc, ví dụ bằng Sune.\nNhận diện trường hợp qua phần màu vàng bạn thấy.",
  "introHowPll": "Mặt trên đã toàn màu vàng.\nT-perm đổi chỗ góc; U-perm hoán vị vòng ba cạnh.\nĐọc màu các mặt bên để chọn công thức.",
  "introHowTwoFirst": "Khối 2×2 chỉ có góc, như 3×3 không có cạnh.\nĐưa mỗi góc trắng lên trên vị trí của nó.\nLặp lại R U R' U' cho đến khi nó vào chỗ.",
  "introHowTwoOll": "Giữ tầng trắng ở dưới.\nSune (R U R' U R U2 R') xoắn các góc ở trên.\nLặp lại từ đúng góc độ cho đến khi mặt trên toàn màu vàng.",
  "introHowTwoPbl": "Tìm một mặt bên có hai góc đã khớp nhau.\nĐổi chỗ kề nhau: một công thức kiểu T-perm.\nĐổi chỗ chéo: một công thức dài hơn.",
  "introHowBigIntro": "Không có tâm cố định: bốn viên tâm tạo nên màu của mỗi mặt.\nNước xoay kép như Rw xoay hai tầng cùng lúc.\nNước xoay tầng trong như 2R chỉ xoay một tầng bên trong.",
  "introHowBigCenters": "Dựng hai tâm đối diện trước.\nCác tầng trong đổi chỗ viên tâm mà không phá các tâm đã xong.\nHoàn thành bốn tâm cuối theo cách tương tự.",
  "introHowBigEdges": "Tìm hai mảnh cạnh cùng màu.\nXếp chúng cạnh nhau bằng một tầng trong.\nCất cặp đó đi và đưa các tâm trở lại.",
  "introHowBigParity": "Giải 4×4 như 3×3 cho đến khi bị kẹt.\nMột cạnh bị lật: công thức parity OLL dài.\nHai cạnh bị đổi chỗ: 2R2 U2 2R2 Uw2 2R2 Uw2.",
