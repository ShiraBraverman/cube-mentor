  "trackFiveByFive": "Professor's Cube 5×5",
  "trackSixBySix": "Khối 6×6",
  "lessonFiveIntro": "Làm quen với 5×5",
  "lessonFiveIntroDesc": "Tâm cố định, thanh tâm, cạnh giữa và cánh.",
  "introGoalFiveIntro": "Làm quen với 5×5: tâm cố định, thanh tâm, cạnh giữa và cánh.",
  "introHowFiveIntro": "Viên chính giữa mỗi mặt không bao giờ di chuyển.\nMỗi cạnh gồm một viên giữa và hai cánh.\nCác tầng trong di chuyển viên mà không động đến bên ngoài.",
  "lessonFiveCenters": "Tâm của 5×5",
  "lessonFiveCentersDesc": "Dựng mỗi tâm từ các thanh ba viên.",
  "introGoalFiveCenters": "Dựng khối tâm 3×3 cùng một màu trên mỗi mặt.",
  "introHowFiveCenters": "Bắt đầu từ viên chính giữa: nó cho biết màu.\nDựng các thanh ba viên và trượt chúng vào bằng một tầng trong.\nHoàn thành hai tâm cuối cùng lúc.",
  "lessonFiveEdges": "Cạnh của 5×5",
  "lessonFiveEdgesDesc": "Ghép hai cánh với cạnh giữa của chúng.",
  "introGoalFiveEdges": "Ghép mỗi cạnh giữa với hai cánh của nó để cả 12 cạnh trông như những viên liền.",
  "introHowFiveEdges": "Khớp hai cánh với cạnh giữa của chúng ở mặt trước.\nXoay tầng trong, đưa một cạnh chưa giải vào, rồi xoay trở lại.\nGhép các cạnh cuối mà không phá các cạnh đã xong.",
  "lessonFiveSolve": "Giải 5×5 như 3×3",
  "lessonFiveSolveDesc": "Hoàn thành với ba vương miện.",
  "introGoalFiveSolve": "Giải khối 5×5 đã rút gọn như 3×3, từng vương miện một.",
  "introHowFiveSolve": "Từ giờ chỉ xoay các tầng ngoài.\nVương miện thứ nhất, thứ hai, rồi đến vương miện vàng.\nCác tâm cố định cho biết màu của mỗi mặt.",
  "lessonFiveParity": "Parity cạnh 5×5",
  "lessonFiveParityDesc": "Sửa cạnh có hai cánh bị đổi chỗ.",
  "introGoalFiveParity": "Sửa cạnh duy nhất có hai cánh bị đổi chỗ, rồi hoàn thành.",
  "introHowFiveParity": "Nó xuất hiện dưới dạng một cạnh không thể ghép.\nThực hiện công thức tầng trong dài một lần.\nMọi thứ khác trở về chỗ cũ.",
  "lessonSixIntro": "Làm quen với 6×6",
  "lessonSixIntroDesc": "Không có tâm cố định và mỗi cạnh có bốn viên.",
  "introGoalSixIntro": "Làm quen với 6×6: mười sáu viên tâm mỗi mặt và bốn viên mỗi cạnh.",
  "introHowSixIntro": "Không có tâm cố định: bạn chọn màu khi dựng.\nMỗi cạnh có cánh ngoài và cánh trong.\nNước xoay kép có thể di chuyển đến ba tầng.",
  "lessonSixCenters": "Tâm của 6×6",
  "lessonSixCentersDesc": "Dựng tâm 4×4 từ các thanh bốn viên.",
  "introGoalSixCenters": "Dựng khối tâm 4×4 cùng một màu liền trên mỗi mặt.",
  "introHowSixCenters": "Dựng hai tâm đối diện trước.\nTạo các thanh bốn viên và trượt chúng lại với nhau.\nDi chuyển từng viên bằng mẹo: tầng trong, tầng trên, hoàn tác.",
  "lessonSixEdges": "Cạnh của 6×6",
  "lessonSixEdgesDesc": "Gom bốn viên của mỗi cạnh.",
  "introGoalSixEdges": "Gom bốn viên của mỗi cạnh để khối 6×6 có 12 cạnh hoàn chỉnh.",
  "introHowSixEdges": "Xếp cánh ngoài và cánh trong thẳng hàng ở mặt trước.\nTầng kép sâu đưa một cạnh vào và ra.\nCác cạnh đã xong không bao giờ bị phá.",
  "lessonSixSolve": "Giải 6×6 như 3×3",
  "lessonSixSolveDesc": "Hoàn thành với ba vương miện.",
  "introGoalSixSolve": "Giải khối 6×6 đã rút gọn như 3×3, từng vương miện một.",
  "introHowSixSolve": "Từ giờ chỉ xoay các tầng ngoài.\nCác tâm bạn đã dựng cho biết màu của mỗi mặt.\nVương miện thứ nhất, thứ hai, rồi đến vương miện vàng.",
  "lessonSixParity": "Parity 6×6",
  "lessonSixParityDesc": "Một cạnh bị lật hoặc hai cạnh bị đổi chỗ.",
  "introGoalSixParity": "Sửa hai trường hợp của 6×6 mà 3×3 không bao giờ có: một cạnh bị lật hoặc hai cạnh bị đổi chỗ.",
  "introHowSixParity": "Giải như 3×3 cho đến khi bị kẹt.\nMột cạnh bị lật: công thức parity dài.\nHai cạnh bị đổi chỗ: công thức ngắn với các nước xoay kép tầng trong.",
  "stepFivePieces": "Các viên của 5×5",
  "stepFivePiecesBody": "Viên chính giữa mỗi mặt không bao giờ di chuyển, nên nó vẫn cho biết màu của mặt, giống như trên 3×3. Quanh nó còn tám viên tâm khác; mỗi cạnh có một viên giữa và hai cánh, còn các góc hoạt động như trên 3×3.",
  "stepFiveSlices": "Ba kiểu xoay",
  "stepFiveSlicesBody": "Nước xoay ngoài di chuyển một mặt. Nước xoay kép di chuyển một mặt cùng tầng phía sau nó. Nước xoay tầng trong chỉ di chuyển một tầng bên trong: đó là cách các viên đổi chỗ mà không động đến bên ngoài.",
  "stepFiveCenterBar": "Thanh tâm",
  "stepFiveCenterBarBody": "Dựng một hàng ba viên tâm cùng màu, rồi trượt nó cạnh viên giữa cùng màu bằng một nước xoay tầng trong. Ba thanh tạo thành một tâm hoàn chỉnh.",
  "stepFiveCenterSwap": "Đổi chỗ mà không phá",
  "stepFiveCenterSwapBody": "Để di chuyển một viên tâm: xoay một tầng trong, xoay tầng trên, hoàn tác tầng trong, xoay tầng trên trở lại. Các tâm đã xong luôn được khôi phục.",
  "stepFiveEdgePair": "Ghép cánh với cạnh giữa",
  "stepFiveEdgePairBody": "Xếp hai cánh cạnh cạnh giữa cùng màu ở mặt trước, xoay tầng trong xuống, đưa một cạnh chưa giải từ tầng trên vào, rồi xoay tầng trong trở lại.",
  "stepFiveEdgeLast": "Các cạnh cuối",
  "stepFiveEdgeLastBody": "Khi chỉ còn vài cạnh, một nước xoay kép, một công thức ngắn và nước xoay kép trở lại sẽ ghép chúng mà không phá các cạnh đã xong.",
  "stepFiveAsThree": "Giờ nó là 3×3",
  "stepFiveAsThreeBody": "Khi tâm và cạnh đã xong, khối 5×5 hoạt động như một khối 3×3 lớn. Chỉ dùng các nước xoay ngoài và làm theo ba vương miện: dấu cộng và góc trắng, tầng giữa, rồi tầng vàng.",
  "stepFiveEdgeParity": "Đổi chỗ hai cánh của cạnh cuối",
  "stepFiveEdgeParityBody": "Đôi khi cạnh cuối có hai cánh bị đổi chỗ. Một công thức tầng trong dài hơn sẽ đổi chúng lại trong khi mọi thứ khác trở về chỗ cũ. Sau đó hoàn thành như 3×3.",
  "stepSixPieces": "Các viên của 6×6",
  "stepSixPiecesBody": "Giống như 4×4, khối 6×6 không có tâm cố định: mười sáu viên tâm tạo nên màu của mỗi mặt. Mỗi cạnh có bốn viên: hai cánh ngoài và hai cánh trong.",
  "stepSixSlices": "Xoay các tầng sâu hơn",
  "stepSixSlicesBody": "Nước xoay kép có thể di chuyển hai hoặc ba tầng tính từ một mặt. Các tầng trong ở tầng thứ hai hoặc thứ ba là công cụ cho tâm và cạnh.",
  "stepSixCenterBar": "Thanh bốn viên",
  "stepSixCenterBarBody": "Dựng các hàng bốn viên tâm cùng màu và trượt chúng cạnh nhau bằng các nước xoay tầng trong cho đến khi mặt có một màu liền.",
  "stepSixCenterSwap": "Di chuyển từng viên một",
  "stepSixCenterSwapBody": "Xoay tầng thứ ba, xoay tầng trên, hoàn tác, xoay trở lại: một viên tâm di chuyển trong khi các tâm đã xong trở về như cũ.",
  "stepSixEdgePair": "Bốn viên, một cạnh",
  "stepSixEdgePairBody": "Gom bốn viên của một cạnh ở mặt trước bằng tầng kép sâu, rồi đưa một cạnh chưa giải vào và xoay tầng kép trở lại.",
  "stepSixEdgeLast": "Các cạnh cuối",
  "stepSixEdgeLastBody": "Ghép các cạnh cuối cùng bằng một công thức ngắn giữa một nước xoay kép sâu và nước hoàn tác của nó, để các cạnh đã xong vẫn được ghép.",
  "stepSixAsThree": "Giờ nó là 3×3",
  "stepSixAsThreeBody": "Với tâm 4×4 và các cạnh đã ghép, giải khối 6×6 như 3×3 bằng các nước xoay ngoài và ba vương miện.",
  "stepSixOllParity": "Một cạnh bị lật",
  "stepSixOllParityBody": "Nếu một cạnh đơn lẻ có vẻ bị lật khi bạn giải tầng cuối, đó là parity. Giữ nó ở phía trước tầng trên và thực hiện công thức dài: hai vương miện đầu sẽ trở lại nguyên vẹn.",
  "stepSixPllParity": "Hai cạnh bị đổi chỗ",
  "stepSixPllParityBody": "Nếu hai cạnh có vẻ bị đổi chỗ ở bước cuối cùng, giữ chúng ở phía trước và phía sau tầng trên rồi thực hiện công thức ngắn gồm các nước xoay kép tầng trong.",
  "stageTwoFirstLayer": "Dựng tầng dưới",
  "stageTwoTopColor": "Làm mặt trên một màu",
  "stageTwoFinish": "Hoàn thành các góc",
  "explainTwoFirstLayer": "Hoàn thành tầng dưới: bốn góc của nó khớp với nhau và với màu các mặt bên.",
  "explainTwoTopColor": "Xoay tầng trên cho đến khi cả bốn miếng dán ở trên cùng một màu, giữ nguyên tầng dưới.",
  "explainTwoFinish": "Đưa các góc cuối về đúng chỗ để hoàn thành khối.",
