  "stepBasicsFaces": "Sáu chữ cái của các mặt",
  "stepBasicsFacesBody": "R, L, U, D, F và B là mặt phải, trái, trên, dưới, trước và sau. Một chữ cái đứng riêng nghĩa là xoay một phần tư vòng theo chiều kim đồng hồ, như khi bạn nhìn thẳng vào mặt đó.",
  "stepBasicsPrime": "Nước ngược và nước kép",
  "stepBasicsPrimeBody": "Dấu phẩy trên (R') nghĩa là xoay ngược lại, ngược chiều kim đồng hồ. Số 2 (U2) là nửa vòng: hai lần một phần tư vòng.",
  "stepCrossGoal": "Mục tiêu",
  "stepCrossGoalBody": "Cầm vàng ở trên và xanh lá hướng về bạn. Trước tiên gom bốn cạnh trắng quanh tâm vàng, trắng hướng lên, như cánh hoa: đó là bông hoa trắng. Sau đó từng cánh hoa đi xuống tâm trắng, màu bên khớp với tâm bên cạnh.",
  "stepCrossTop": "Cạnh ở tầng trên",
  "stepCrossTopBody": "Một cạnh trắng ở trên có màu trắng hướng lên là một cánh hoa. Xoay tầng trên đến khi màu bên của nó nằm ngay trên tâm cùng màu, rồi xoay mặt đó hai lần (180°) để đưa nó xuống tâm trắng.",
  "stepCrossMiddle": "Cạnh ở tầng giữa",
  "stepCrossMiddleBody": "Cạnh mắc ở tầng giữa phải lên trước: xoay mặt bên của nó lên, đẩy tầng trên sang bên rồi xoay mặt bên lại, để các mảnh đã đặt không bị xê dịch. Giờ nó là cánh hoa ở trên: căn rồi xoay mặt đó hai lần.",
  "stepCornersInsert": "Ngay trên vị trí",
  "stepCornersInsertBody": "Xoay tầng trên đến khi góc trắng nằm ngay trên ô của nó, giữa hai tâm cùng màu với các màu bên. Ở đây chỉ cần một lượt xoay trên và R U' R': U đưa góc lên trên ô, R U' R' đưa nó vào với màu trắng hướng xuống.",
  "stepCornersRepeat": "Lặp lại công thức",
  "stepCornersRepeatBody": "Giữ ô ở trước bên phải và lặp R U R' U' đến khi trắng hướng xuống: 1 lần nếu trắng quay sang phải, 3 lần nếu quay lên, 5 lần nếu quay về phía bạn. Tầng trên trông rối trong lúc đó; nó sẽ tự gọn lại.",
  "stepMiddleRight": "Cạnh sang phải",
  "stepMiddleRightBody": "Tìm một cạnh tầng trên không có màu vàng. Xoay tầng trên đến khi màu trước của nó khớp với tâm trước mặt bạn. Nếu màu trên của nó khớp với tâm bên phải, đưa sang phải: U R U' R' U' F' U F.",
  "stepMiddleLeft": "Cạnh sang trái",
  "stepMiddleLeftBody": "Nếu màu trên khớp với tâm bên trái, dùng công thức đối xứng: U' L' U L U F U' F'. Tầng trắng luôn trở lại nguyên vẹn.",
  "stepYellowCross": "Một công thức",
  "stepYellowCrossBody": "Chỉ nhìn các cạnh vàng ở trên. Giữ chữ L ở sau bên trái và đường thẳng nằm ngang, rồi làm F R U R' U' F'. Đường thẳng cần 1 lần, chữ L 2 lần, chấm tối đa 3 lần.",
  "stepYellowEdges": "Khớp các cạnh",
  "stepYellowEdgesBody": "Xoay tầng trên đến khi hai cạnh khớp với tâm của chúng. Khi một cạnh ở sau và một ở bên phải, R U R' U R U2 R' U đổi chỗ cạnh trước và cạnh trái.",
  "stepPlaceCorners": "Đặt đúng chỗ",
  "stepPlaceCornersBody": "Một góc đã đúng chỗ khi màu của nó khớp với ba tâm xung quanh, dù còn xoay lệch. Giữ góc như vậy ở trước bên phải: U R U' L' U R' U' L xoay vòng ba góc còn lại. Lặp đến khi cả bốn đều đúng chỗ.",
  "stepTwistCorners": "Xoắn góc",
  "stepTwistCornersBody": "Với một góc chưa xong ở trước bên phải, lặp R' D' R D theo từng cặp đến khi vàng ở trên, rồi chỉ xoay tầng trên để đưa góc tiếp theo tới. Phần dưới trông bị phá đến góc cuối cùng: cứ tiếp tục.",
  "lessonCfopIntro": "CFOP là gì?",
  "lessonCfopIntroDesc": "Cross, F2L, OLL, PLL.",
  "stepCfopOverview": "Bốn giai đoạn",
  "stepCfopOverviewBody": "Người chơi speedcube giải dấu cộng, rồi ghép mỗi góc tầng một với cạnh tầng giữa của nó (F2L), định hướng tầng cuối (OLL) và cuối cùng hoán vị nó (PLL).",
  "stepCfopCross": "Lên kế hoạch dấu cộng",
  "stepCfopCrossBody": "Trong CFOP, dấu cộng được lên kế hoạch trong lúc quan sát và dựng ở mặt dưới trong khoảng tám nước.",
  "lessonF2l": "F2L cơ bản",
  "lessonF2lDesc": "Ghép một góc với cạnh của nó.",
  "stepF2lRight": "Đưa một cặp vào",
  "stepF2lRightBody": "Khi một góc và cạnh của nó nằm cạnh nhau ở tầng trên, đưa chúng lên trên ô của chúng và đưa vào cùng lúc.",
  "stepF2lLeft": "Cặp bên trái",
  "stepF2lLeftBody": "Trường hợp tương tự ở phía bên kia là công thức đối xứng, U' L' U L. Xoay cả khối (y) giúp bạn dùng tay nào thuận hơn.",
  "lessonOll": "OLL hai bước",
  "lessonOllDesc": "Làm mặt trên thành màu vàng.",
  "stepOllCross": "Cạnh trước",
  "stepOllCrossBody": "OLL hai bước bắt đầu bằng công thức dấu cộng vàng mà bạn đã biết.",
  "stepOllSune": "Sune",
  "stepOllSuneBody": "Với một góc vàng hướng lên ở phía trước bên trái, Sune (R U R' U R U2 R') định hướng ba góc còn lại. Hầu hết các trường hợp khác dùng Sune và bản đối xứng của nó.",
  "lessonPll": "PLL hai bước",
  "lessonPllDesc": "Hoàn thành khối.",
  "stepPllT": "T-perm",
  "stepPllTBody": "T-perm đổi chỗ hai góc và hai cạnh. Dùng nó để đặt các góc: giữ hai góc cần đổi chỗ ở bên phải.",
  "stepPllU": "U-perm",
  "stepPllUBody": "Khi các góc đã xong, U-perm hoán vị vòng ba cạnh. Giữ mặt đã hoàn chỉnh ở phía sau.",
  "lessonTwoFirst": "Tầng một của 2×2",
  "lessonTwoFirstDesc": "Dựng một mặt với các góc khớp nhau.",
  "stepTwoIntro": "Chỉ có góc",
  "stepTwoIntroBody": "2×2 chỉ có tám góc: không cạnh, không tâm. Ghép tầng trắng ở dưới với màu bên của các góc kề khớp nhau, rồi hoàn thành theo một lộ trình: Sune để mặt trên vàng, sau đó T-perm hoặc Y-perm.",
  "stepTwoCorner": "Đưa góc vào",
  "stepTwoCornerBody": "Giống các góc trắng của 3×3: đưa một góc lên trên ô trống ở trước bên phải rồi đưa vào, ở đây bằng U R U' R' hoặc lặp R U R' U' đến khi trắng hướng xuống. Kiểm tra màu bên với góc bên cạnh.",
  "lessonTwoOll": "Định hướng mặt trên",
  "lessonTwoOllDesc": "OLL Ortega với Sune.",
  "stepTwoSune": "Lại là Sune",
  "stepTwoSuneBody": "Đếm số miếng dán vàng hướng lên. Giữ góc duy nhất có vàng hướng lên ở trước bên trái và làm Sune (R U R' U R U2 R'). Đếm lại và cầm lại; tối đa ba lần Sune. Ở giữa chỉ xoay tầng trên.",
  "lessonTwoPbl": "Hoán vị cả hai tầng",
  "lessonTwoPblDesc": "Đổi chỗ các góc để hoàn thành.",
  "stepTwoAdjacent": "Đổi chỗ kề nhau",
  "stepTwoAdjacentBody": "Headlights là hai miếng dán trên cùng màu ở một mặt bên. Xoay tầng trên đến khi headlights ở bên trái, để hai góc cần đổi nằm bên phải, rồi làm T-perm.",
  "stepTwoDiagonal": "Đổi chỗ chéo",
  "stepTwoDiagonalBody": "Không có headlights ở mặt nào nghĩa là hai góc chéo nhau cần đổi chỗ: làm Y-perm từ bất kỳ phía nào, rồi xoay tầng trên cho thẳng hàng.",
  "lessonBigIntro": "Các viên của khối lớn",
  "lessonBigIntroDesc": "Tâm, cánh và tầng giữa.",
  "stepBigPieces": "Không có tâm cố định",
  "stepBigPiecesBody": "Ở 4×4 mỗi mặt có bốn mảnh tâm di chuyển được, và mỗi cạnh gồm hai cánh. Không có tâm cố định, nên hãy kiểm tra thứ tự màu trên một góc: trắng đối vàng, xanh dương đối xanh lá, đỏ đối cam.",
  "stepBigSlices": "Xoay kép và xoay tầng trong",
  "stepBigSlicesBody": "Rw xoay cùng lúc hai tầng bên phải. 2R chỉ xoay tầng thứ hai tính từ bên phải. Các nước này di chuyển tâm và cánh.",
  "lessonBigCenters": "Tâm",
  "lessonBigCentersDesc": "Gom các viên tâm.",
  "stepBigCenterCycle": "Hoán vị vòng 3 viên tâm",
  "stepBigCenterCycleBody": "Commutator này di chuyển đúng ba mảnh tâm và giữ nguyên mọi thứ khác, nên tâm đã xong vẫn xong. Dùng nó khi một mảnh lạc không chịu vào thanh.",
  "lessonBigEdges": "Ghép cạnh",
  "lessonBigEdgesDesc": "Ghép các cánh thành cạnh hoàn chỉnh.",
  "stepBigEdgePair": "Ghép và khôi phục",
  "stepBigEdgePairBody": "Uw' xếp thẳng hai cánh cùng màu, R U R' F R' F' R đổi vào một cạnh chưa ghép, và Uw trả các tâm về. Luôn đóng lát bạn đã mở.",
  "lessonBigParity": "Parity",
  "lessonBigParityDesc": "Parity OLL và PLL trên khối chẵn.",
  "stepBigOllParity": "Parity OLL",
  "stepBigOllParityBody": "Một cạnh bị lật đơn lẻ không thể xảy ra ở 3×3: đó là parity OLL, không phải lỗi. Giữ nó ở trước tầng trên và làm công thức dài. Nó cũng đổi chỗ cạnh trên trái và phải cùng hai góc; các bước 3×3 cuối sẽ sửa chúng.",
  "stepBigPllParity": "Parity PLL",
  "stepBigPllParityBody": "Hai cạnh bị đổi chỗ ở cuối và không công thức 3×3 nào hợp? Đó là parity PLL. Giữ chúng ở trước và sau tầng trên: 2R2 U2 2R2 Uw2 2R2 2U2 đổi chúng lại.",
  "introGoalHeading": "Mục tiêu là gì?",
  "introHowHeading": "Làm thế nào?",
  "introHoldHeading": "Cách cầm",
  "introWhyHeading": "Vì sao hiệu quả",
  "introStart": "Hiểu rồi, bắt đầu từng bước",
  "introDontShowAgain": "Không tự động hiển thị nữa",
  "introShowGoal": "Xem mục tiêu",
  "introStateStart": "Bắt đầu",
  "introStateGoal": "Mục tiêu",
  "introPlayMorph": "Phát từ đầu đến mục tiêu",
  "introGoalBasics": "Học cách đọc khối: các viên, sáu mặt và cách các chữ cái ký hiệu xoay chúng.",
  "introGoalCross": "Tạo dấu cộng trắng ở dưới, trong đó mỗi cạnh trắng cũng khớp với màu tâm bên cạnh.",
  "introGoalCorners": "Đặt bốn góc trắng để hoàn thành cả tầng 1: mặt trắng và các màu bên khớp nhau.",
  "introGoalMiddle": "Đặt bốn cạnh tầng giữa để hoàn thành hai tầng đầu.",
  "introGoalYellowCross": "Tạo dấu cộng vàng ở trên; màu mặt bên chưa cần khớp.",
  "introGoalYellowEdges": "Căn mỗi cạnh của dấu cộng vàng với màu tâm ở mặt bên của nó.",
  "introGoalYellowCorners": "Đưa mỗi góc vàng về đúng chỗ, kể cả khi nó vẫn còn bị xoắn.",
  "introGoalTwistCorners": "Xoắn các góc vàng đúng hướng để cả khối được giải.",
  "introGoalCfopIntro": "Xem kế hoạch của speedcube: dấu cộng, hai tầng đầu, rồi tầng cuối trong hai bước.",
  "introGoalF2l": "Đưa mỗi góc trắng vào cùng với cạnh tầng giữa của nó, hoàn thành hai tầng cùng lúc.",
  "introGoalOll": "Làm cả mặt trên thành màu vàng bằng một hoặc hai công thức.",
  "introGoalPll": "Đưa các viên tầng cuối về đúng chỗ để hoàn thành khối.",
  "introGoalTwoFirst": "Dựng một tầng trắng hoàn chỉnh trên khối 2×2.",
  "introGoalTwoOll": "Làm mặt trên của 2×2 thành toàn màu vàng.",
  "introGoalTwoPbl": "Đưa các góc cuối về chỗ bằng một T-perm hoặc Y-perm, rồi chỉnh tầng trên để giải xong khối 2×2.",
  "introGoalBigIntro": "Làm quen với 4×4: tâm, cặp cạnh và góc, cùng các nước xoay chúng.",
  "introGoalBigCenters": "Gom các viên tâm của mỗi mặt thành một khối màu liền.",
  "introGoalBigEdges": "Ghép các mảnh cạnh cùng màu để mỗi cạnh trông như một cạnh 3×3.",
  "introGoalBigParity": "Sửa hai trường hợp của 4×4 mà 3×3 không bao giờ có: một cạnh bị lật (parity OLL) hoặc hai cạnh bị đổi chỗ (parity PLL).",
  "introHowBasics": "Tâm không bao giờ di chuyển, nên chúng cho biết màu của mỗi mặt.\nMỗi chữ cái xoay một mặt một phần tư vòng theo chiều kim đồng hồ.\nDấu phẩy trên (') xoay ngược lại; số 2 xoay hai lần.",
  "introHoldBasics": "Cầm tùy ý: các tâm không di chuyển, nên màu sắc luôn cho bạn biết mặt nào là mặt nào.",
  "introWhyBasics": "Mọi công thức chỉ là một dãy các chữ cái này, nên đọc được chúng là kỹ năng đầu tiên.",
  "introHowCross": "Đưa từng cạnh trắng lên trên, màu trắng hướng lên, quanh tâm vàng: đó là bông hoa trắng.\nXoay tầng trên đến khi màu bên của một cánh hoa nằm trên tâm cùng màu.\nXoay mặt đó 180° để đưa nó xuống; làm vậy với cả bốn.",
  "introHoldCross": "Tâm vàng ở trên, tâm trắng ở dưới suốt bước này. Xoay tầng trên, không xoay cả khối, để căn một cánh hoa.",
  "introWhyCross": "Khi trắng hướng lên, hai lượt xoay mặt trước đặt cạnh xuống tâm trắng, trắng hướng xuống và màu bên đã khớp sẵn.",
  "introHowCorners": "Xoay tầng trên đến khi một góc trắng nằm trên ô trống của nó, ở trước bên phải.\nLặp R U R' U': 1 lần nếu trắng quay sang phải, 3 lần nếu quay lên, 5 lần nếu quay về phía bạn.\nLàm tương tự với ba góc còn lại.",
  "introHoldCorners": "Trắng dưới, vàng trên. Góc ở trước bên phải, ngay trên chỗ của nó.",
  "introWhyCorners": "R U R' U' nhấc ô lên rồi đặt lại: mỗi vòng xoay góc một chút đến khi trắng hướng xuống, và dấu cộng không bao giờ bị phá.",
  "introHowMiddle": "Tìm một cạnh tầng trên không có màu vàng và khớp màu trước của nó với tâm bên dưới.\nMàu trên của nó cho biết nó đi đâu: sang phải hay sang trái.\nĐưa vào bằng công thức 8 bước; tầng trắng luôn trở lại nguyên vẹn.",
  "introHoldMiddle": "Trắng dưới, vàng trên. Cạnh ở mặt trước, màu trước của nó khớp với tâm bên dưới.",
  "introWhyMiddle": "Công thức nhấc ô ra, đưa cạnh vào và trả lại tầng trắng. Cạnh có màu vàng thuộc tầng trên, không bao giờ ở giữa.",
  "introHowYellowCross": "Chỉ nhìn các cạnh vàng trên đỉnh: chấm, chữ L hoặc đường thẳng.\nGiữ chữ L ở sau bên trái, đường thẳng nằm ngang, rồi làm F R U R' U' F'.\nĐường thẳng cần 1 lần, chữ L 2 lần, chấm tối đa 3 lần.",
  "introHoldYellowCross": "Trắng dưới, vàng trên. Chữ L ở sau bên trái, đường thẳng nằm ngang; chấm cầm sao cũng được.",
  "introWhyYellowCross": "F R U R' U' F' lật hai cạnh trên mỗi lần mà không chạm vào hai tầng đầu.",
  "introHowYellowEdges": "Xoay tầng trên đến khi hai cạnh khớp với tâm của chúng.\nGiữ chúng ở phía sau và bên phải, rồi làm R U R' U R U2 R' U.\nNếu hai cạnh khớp nằm đối diện, làm một lần từ bất kỳ phía nào trước.",
  "introHoldYellowEdges": "Vàng ở trên. Một cạnh khớp ở phía sau, cạnh kia ở bên phải.",
  "introWhyYellowEdges": "Công thức này chỉ di chuyển mảnh ở tầng trên, nên hai tầng đầu luôn trở lại.",
  "introHowYellowCorners": "Một góc đã đúng chỗ khi màu của nó khớp với ba tâm xung quanh, dù còn bị xoay lệch.\nGiữ một góc đúng chỗ ở trước bên phải.\nU R U' L' U R' U' L xoay vòng ba góc còn lại; lặp đến khi tất cả vào chỗ.",
  "introHoldYellowCorners": "Vàng ở trên. Một góc đã đúng chỗ ở trước bên phải; nếu không có, góc nào cũng được.",
  "introWhyYellowCorners": "Nó xoay vòng ba góc và giữ nguyên góc trước bên phải, nên mỗi lần lặp lại đưa thêm góc về chỗ.",
  "introHowTwistCorners": "Giữ một góc chưa xong ở trước bên phải.\nLặp R' D' R D theo từng cặp đến khi màu vàng của nó hướng lên.\nChỉ xoay tầng trên cho góc tiếp theo; phần dưới sẽ trở lại ở góc cuối.",
  "introHoldTwistCorners": "Vàng ở trên, góc cần xoay ở trước bên phải. Giữa các góc chỉ xoay tầng trên, không bao giờ xoay cả khối.",
  "introWhyTwistCorners": "R' D' R D xoay góc và làm rối phần dưới, nhưng phần dưới trở lại khi mọi góc đã xoay xong. Dừng giữa chừng sẽ để nó bị rối.",
  "introHowCfopIntro": "Cross: bốn cạnh, lên kế hoạch trong lúc quan sát.\nF2L: mỗi góc được đưa vào cùng với cạnh của nó.\nOLL làm mặt trên thành màu vàng, rồi PLL đưa các viên về chỗ.",
  "introHoldCfopIntro": "Speedcuber làm dấu cộng ở dưới để nhìn trước các mảnh tiếp theo trong lúc xoay.",
  "introWhyCfopIntro": "Giải một góc cùng cạnh của nó tiết kiệm nhiều nước, và nhận diện trường hợp thay cho thử và sai.",
  "introHowF2l": "Tìm một góc và cạnh cùng màu với nó ở tầng trên.\nGhép chúng thành cặp ngay trên ô của chúng.\nĐưa cặp vào bằng ba hoặc bốn nước.",
  "introHoldF2l": "Dấu cộng ở dưới. Ô của cặp ở trước bên phải, hoặc trước bên trái với trường hợp đối xứng.",
  "introWhyF2l": "Góc và cạnh đã ghép cặp vào cùng nhau, nên hai tầng lớn lên cùng lúc thay vì từng mảnh.",
  "introHowOll": "Trước hết là dấu cộng vàng với F R U R' U' F'.\nSau đó định hướng các góc, ví dụ bằng Sune.\nNhận diện trường hợp qua phần màu vàng bạn thấy.",
  "introHoldOll": "Vàng ở trên. Với Sune, góc duy nhất có vàng hướng lên đặt ở trước bên trái.",
  "introWhyOll": "Chia tầng cuối thành định hướng trước, hoán vị sau giúp số công thức ít.",
  "introHowPll": "Mặt trên đã toàn màu vàng.\nT-perm đổi chỗ góc; U-perm hoán vị vòng ba cạnh.\nĐọc màu các mặt bên để chọn công thức.",
  "introHoldPll": "Vàng ở trên. T-perm: headlights bên trái. U-perm: mặt đã xong ở phía sau.",
  "introWhyPll": "Khi tầng trên đã vàng hết, chỉ còn vị trí các mảnh sai, và vài lần hoán đổi là xong khối.",
  "introHowTwoFirst": "Chọn một góc trắng làm mốc, màu trắng hướng xuống.\nĐưa từng góc tiếp theo lên trên chỗ của nó, ở trước bên phải.\nLặp R U R' U' đến khi nó vào chỗ với các màu bên khớp nhau.",
  "introHoldTwoFirst": "Trắng ở dưới. Ô trống ở trước bên phải, góc của nó ngay phía trên ở tầng trên.",
  "introWhyTwoFirst": "2×2 không có tâm: góc đầu tiên bạn đặt quyết định màu của các góc bên cạnh, nên màu bên quan trọng, không chỉ màu trắng.",
  "introHowTwoOll": "Đếm số góc có màu vàng hướng lên.\nNếu có một, giữ nó ở trước bên trái và làm Sune: R U R' U R U2 R'.\nĐếm lại và lặp; tối đa ba lần Sune.",
  "introHoldTwoOll": "Trắng dưới, vàng trên. Trước mỗi lần Sune, góc có vàng hướng lên ở trước bên trái.",
  "introWhyTwoOll": "Sune xoay các góc trên mà không phá tầng trắng; đếm lại cho bạn biết cách cầm lần sau.",
  "introHowTwoPbl": "Tìm headlights: hai miếng dán trên cùng màu ở một mặt bên.\nCó headlights ở một mặt: đưa sang trái và làm T-perm.\nKhông có headlights: làm Y-perm từ bất kỳ phía nào, rồi chỉnh tầng trên.",
  "introHoldTwoPbl": "Trắng dưới, vàng trên. T-perm: headlights bên trái. Y-perm: mặt nào hướng về bạn cũng được.",
  "introWhyTwoPbl": "Khi tầng trên đã vàng, chỉ còn vị trí góc sai: T-perm đổi hai góc kề nhau, Y-perm đổi hai góc chéo.",
  "introHowBigIntro": "Không có tâm cố định: bốn viên tâm tạo nên màu của mỗi mặt.\nNước xoay kép như Rw xoay hai tầng cùng lúc.\nNước xoay tầng trong như 2R chỉ xoay một tầng bên trong.",
  "introHoldBigIntro": "Ban đầu cầm tùy ý: 4×4 không có tâm cố định, nên bạn tự chọn chỗ của mỗi màu.",
  "introWhyBigIntro": "Thu gọn gom tâm và mảnh cạnh để khối lớn được giải như 3×3.",
  "introHowBigCenters": "Trước hết kiểm tra thứ tự màu trên một góc.\nGhép hai tâm đối diện, rồi bốn tâm còn lại.\nCác lát trong di chuyển mảnh tâm; luôn trả lại lát bạn đã mở.",
  "introHoldBigCenters": "Mặt đang ghép ở phía trước; các tâm đã xong ở bên trái và phải, tránh vướng.",
  "introWhyBigCenters": "Một lát di chuyển tâm, và hoàn tác nó trả lại các tâm đã xong, nên chỉ mảnh bạn nhắm tới thay đổi.",
  "introHowBigEdges": "Tìm hai cánh có cùng hai màu.\nXếp chúng ở mặt trước và nối lại bằng Uw'.\nĐổi vào một cạnh chưa ghép, rồi Uw trả các tâm về.",
  "introHoldBigEdges": "Cạnh đang ghép ở các lớp phía trước; cạnh đã xong cất ở tầng trên và tầng dưới.",
  "introWhyBigEdges": "Uw' đẩy các tâm sang bên để hai cánh gặp nhau; Uw trả chúng về và công sức của bạn vẫn nguyên.",
  "introHowBigParity": "Giải 4×4 như 3×3 đến khi bị kẹt.\nMột cạnh bị lật: công thức dài parity OLL.\nHai cạnh đổi chỗ: 2R2 U2 2R2 Uw2 2R2 2U2.",
  "introHoldBigParity": "Tầng cuối ở trên. Parity OLL: cạnh bị lật ở phía trước. Parity PLL: hai cạnh đổi chỗ ở phía trước và phía sau.",
  "introWhyBigParity": "Các cánh có thể rơi vào trạng thái mà 3×3 không có; các công thức này xoay lát trong để hoàn tác đúng điều đó.",
