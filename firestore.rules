rules_version = '2';

// CubeMentor: live global Daily Challenge leaderboard.
// daily_challenges/{YYYY-MM-DD}/entries/{uid} holds one player's best solve
// of that UTC day. Players sign in anonymously (Firebase Auth); they can
// read every day's ranking and write only their own entry.
// Paste into Firebase Console > Firestore Database > Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    match /daily_challenges/{day}/entries/{uid} {
      allow read: if request.auth != null;

      allow create: if isOwner(uid) && validDay(day) && validEntry();

      // Updates may only keep or improve the stored time.
      allow update: if isOwner(uid) && validDay(day) && validEntry()
        && request.resource.data.timeMs <= resource.data.timeMs;

      allow delete: if false;
    }

    // Nothing else is readable or writable.
    match /{document=**} {
      allow read, write: if false;
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validDay(day) {
      return day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function validEntry() {
      let d = request.resource.data;
      return d.keys().hasOnly(['nickname', 'timeMs', 'moves', 'updatedAt'])
        && d.keys().hasAll(['nickname', 'timeMs', 'moves', 'updatedAt'])
        && d.nickname is string && d.nickname.size() <= 24
        && d.timeMs is int && d.timeMs >= 2000 && d.timeMs <= 3600000
        && d.moves is int && d.moves >= 0 && d.moves <= 10000
        && d.updatedAt == request.time;
    }
  }
}
